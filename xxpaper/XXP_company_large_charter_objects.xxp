TEMPLATE_large_charter_default:
  - charter_interior_box
  - rotate
  - outside_box
  - title_box
  - token_embed
  - label_text
  - top_note_text
  - comment_text
  - long_name_text
  - token_1_circle
  - token_2_circle
  - token_3_circle
  - token_4_circle
  - token_5_circle
  - token_6_circle
  - token_7_circle
  - token_8_circle
  - token_9_circle
  - token_1_text
  - token_2_text
  - token_3_text
  - token_4_text
  - token_5_text
  - token_6_text
  - token_7_text
  - token_8_text
  - token_9_text

outside_box:
  x_inset: 15
  y_inset: 15
  x: $[${large_charter_interior_box/y} - (2 * ${outside_box/y_inset})]
  y: $[${large_charter_interior_box/x} - (2 * ${outside_box/x_inset})]
  radius: 45
  stroke: ${colour/xxp/BLACK}
  width: 6
  fill: $[desaturate_and_brighten (${_/_related_fill}, 0.04, 0.95)]

title_box:
  x_inset: ${outside_box/x_inset}
  y_inset: $[${outside_box/y} - 90 + 15]
  x: ${outside_box/x}
  y: 90
  radius: 45
  stroke: ${colour/xxp/BLACK}
  width: 6
  fill: ${_/_related_fill}

token_embed:
  typ: token
  scale: 2
  x_inset: 25
  y_inset: 304

label_text:
  typeface: ${DEFAULT/typeface_italic}
  size: 20
  x_inset: 15
  y_inset: 264
  text: Assets, Treasury & Trains
  x: $[${outside_box/x} / 2]
  y: 0
  h_center: 0
  v_center: 0
  fill: $[black_or_white (${outside_box/fill})]

top_note_text:
  suppress: True
  typeface: ${DEFAULT/typeface}
  size: 12
  x: $[${outside_box/x} / 2]
  y: 0
  x_inset: 15
  y_inset: 234
  h_center: 0
  v_center: 0
  fill: $[black_or_white (${outside_box/fill})]

comment_text:
  suppress: False
  text: ""
  typeface: ${DEFAULT/typeface_italic}
  size: 12
  x_inset: 15
  y_inset: 30
  x: $[${outside_box/x} / 2]
  y: 0
  h_center: 0
  v_center: -1
  fill: $[black_or_white (${outside_box/fill})]

long_name_text:
  h_center: 0
  v_center: 0
  size: 30
  x: $[(${token_embed/x_inset} * 2) + (${outside_box/x} - ${token_embed/x_inset}) / 2]
  y: 339
  fill: $[black_or_white (${_/_related_fill})]

token_1_circle:
  suppress: $["${token_1_text/text}" == ""]
  x: 69
  y: 264
  radius: 18
  width: 0.5
  stroke: ${colour/xxp/BLACK}
  fill:  ${colour/xxp/WHITE}

token_1_text:
  suppress: $["${token_1_text/text}" == ""]
  typeface: ${DEFAULT/typeface}
  x: $[${token_1_circle/x}]
  y: $[${token_1_circle/y} - 4]
  h_center: 0
  v_center: 0
  fill: $[black_or_white (${token_1_circle/fill})]

token_2_circle:
  suppress: $["${token_2_text/text}" == ""]
  x: $[${token_1_circle/x}]
  y: $[${token_1_circle/y} - 47]
  radius: 18
  width: 0.5
